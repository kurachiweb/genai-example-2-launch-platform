# 環境変数(シークレットを含む)
.env
.env.*

# Wranglerのローカルシークレットファイル
.dev.vars
.dev.vars.*

# OpenTofuの状態ファイル・変数ファイル(シークレットを含む)
.terraform
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# OpenTofuのクラッシュログ(プロバイダへ渡した値を含み得る)
crash.log
crash.*.log

# Bunでインストールしたパッケージ
node_modules

# OS生成ファイル
# macOS
.DS_Store
# Windows
Thumbs.db
desktop.ini
# Linux(KDE Plasma)
.directory

# 共通ディレクトリのエイリアス
apps/api/db
apps/event/db
apps/api/lib
apps/event/lib
apps/client/lib
apps/admin/lib

# ローカル開発の蓄積データ
apps/email
# Wrangler D1・R2ローカルモードの実データ置き場
.wrangler

# MikroORMのメタデータキャッシュ・コンパイル済み関数出力先
/apps/db/temp
/apps/db/metadata.json
/apps/db/compiled-functions.js

# フロントエンドのビルド成果物
.tanstack
.output
/apps/client/dist
/apps/admin/dist
storybook-static
*.tsbuildinfo

# テスト成果物
# Bun(`bun test --coverage`のデフォルト出力先)
coverage
# Playwright(スクリーンショット・動画・トレースの格納先)
test-results
# Playwright(HTMLレポートの出力先)
playwright-report
# Playwright MCPの出力先
.playwright-mcp

# 生成AI用
.claude/settings.local.json
