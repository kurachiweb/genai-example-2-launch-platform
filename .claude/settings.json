{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(infisical --telemetry=false run *)",
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun update *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun exec *)",
      "Bash(bunx *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk tree *)",
      "Bash(rtk read *)",
      "Bash(rtk du *)",
      "Bash(rtk tsc *)",
      "Bash(rtk wc *)",
      "Bash(rtk proxy *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "Bash(rtk git grep *)",
      "Bash(rtk git status)",
      "Bash(rtk git diff*)",
      "Bash(rtk git log*)",
      "Bash(rtk git show*)",
      "WebSearch",
      "mcp__cloudflare-api__docs"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.dev.vars)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.infisical/secrets-backup/**)",
      "Read(~/.wrangler/config/default.toml)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.dev.vars)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.backup)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.infisical/secrets-backup/**)",
      "Edit(~/.wrangler/config/default.toml)"
    ]
  },
  "showThinkingSummaries": true,
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "playwright",
    "cloudflare-api",
    "cloudflare-bindings",
    "cloudflare-builds",
    "cloudflare-observability"
  ],
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
