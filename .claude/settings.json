{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk tree *)",
      "Bash(rtk read *)",
      "Bash(rtk du *)",
      "Bash(rtk jest *)",
      "Bash(rtk tsc *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)"
    ]
  },
  "showThinkingSummaries": true
}
