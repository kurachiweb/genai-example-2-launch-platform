{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "showThinkingSummaries": true,
  "skillListingBudgetFraction": 0.035,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun -e \"let input=\\\"\\\";process.stdin.on(\\\"data\\\",chunk=>input+=chunk);process.stdin.on(\\\"end\\\",()=>{const payload=JSON.parse(input);const toolInput=payload.tool_input||{};const filePath=toolInput.file_path||\\\"\\\";if(/\\.(md|html|svg|json|jsonc|json5|yaml|yml|sql|csv|txt)\\$/.test(filePath)){process.exit(0)}let content=\\\"\\\";if(payload.tool_name===\\\"Write\\\"){content=toolInput.content||\\\"\\\"}else if(payload.tool_name===\\\"Edit\\\"){let existing=\\\"\\\";try{existing=require(\\\"fs\\\").readFileSync(toolInput.file_path,\\\"utf8\\\")}catch{}content=toolInput.replace_all?existing.split(toolInput.old_string||\\\"\\\").join(toolInput.new_string||\\\"\\\"):existing.replace(toolInput.old_string||\\\"\\\",()=>toolInput.new_string||\\\"\\\")}const lineCount=content.split(\\\"\\n\\\").length;if(lineCount>800){console.error(\\\"[Hook] ブロック: ファイルが800行を超えています(\\\"+lineCount+\\\"行)\\\");console.error(\\\"[Hook] より小さなモジュールに分割してください\\\");process.exit(2)}})\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(infisical --telemetry=false run --env=dev -- bun run dev*)",
      "Bash(NODE_ENV=production infisical --telemetry=false run --env=dev -- bunx vite build*)",
      "Bash(NODE_ENV=production infisical --telemetry=false run --env=dev -- bunx vite preview*)",
      "Bash(infisical --telemetry=false run --env=dev -- wrangler dev *)",
      "Bash(wrangler d1 migrations apply genai-example-2-dev --local *)",
      "Bash(bun install*)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun update *)",
      "Bash(bun test*)",
      "Bash(bunx playwright test*)",
      "Bash(rtk find */workspace/*)",
      "Bash(rtk grep */workspace/*)",
      "Bash(rtk rg */workspace/*)",
      "Bash(rtk ls */workspace/*)",
      "Bash(rtk tree */workspace/*)",
      "Bash(rtk cat */workspace/*)",
      "Bash(rtk tsc *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "Bash(rtk git grep *)",
      "Bash(rtk git status)",
      "Bash(rtk git diff*)",
      "Bash(rtk git log*)",
      "Bash(rtk git show*)",
      "WebSearch",
      "mcp__cloudflare-docs__search_cloudflare_documentation"
    ],
    "deny": [
      "Bash(*git config *)",
      "Bash(*git push --force*)",
      "Bash(*git push * prod*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh repo delete*)",
      "Bash(*gh workflow run*)",
      "Bash(*gh workflow disable*)",
      "Bash(*gh secret set*)",
      "Bash(*gh secret delete*)",
      "Bash(*gh variable set*)",
      "Bash(*gh variable delete*)",
      "Bash(*infisical secrets set*)",
      "Bash(*infisical secrets delete*)",
      "Bash(*infisical secrets folders create*)",
      "Bash(*infisical secrets folders delete*)",
      "Bash(*infisical reset*)",
      "Bash(*wrangler delete*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler triggers deploy*)",
      "Bash(*wrangler dev*--remote*)",
      "Bash(*wrangler d1 delete*)",
      "Bash(*wrangler d1 * --remote*)",
      "Bash(*wrangler d1 time-travel restore*)",
      "Bash(*wrangler r2 * delete*)",
      "Bash(*wrangler kv * delete*)",
      "Bash(*wrangler secret*)",
      "Bash(*tofu apply*)",
      "Bash(*tofu destroy*)",
      "Bash(*tofu import*)",
      "Bash(*tofu state rm*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.dev.vars)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.infisical/**)",
      "Read(~/.wrangler/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.dev.vars)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.backup)",
      "Edit(.claude/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.infisical/**)",
      "Edit(~/.wrangler/**)"
    ]
  },
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "playwright",
    "cloudflare-api",
    "cloudflare-docs",
    "cloudflare-bindings",
    "cloudflare-builds",
    "cloudflare-observability"
  ]
}
