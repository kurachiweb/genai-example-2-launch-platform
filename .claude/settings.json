{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun update *)",
      "Bash(bun run *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun exec *)",
      "Bash(bunx *)",
      "Bash(node -e *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk tree *)",
      "Bash(rtk read *)",
      "Bash(rtk du *)",
      "Bash(rtk tsc *)",
      "Bash(rtk proxy *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "WebSearch",
      "mcp__cloudflare-docs__search_cloudflare_documentation"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.dev.vars*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)"
    ]
  },
  "showThinkingSummaries": true,
  "enabledMcpjsonServers": [
    "chrome-devtools",
    "playwright",
    "cloudflare-api",
    "cloudflare-docs",
    "cloudflare-bindings",
    "cloudflare-builds",
    "cloudflare-observability"
  ],
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
