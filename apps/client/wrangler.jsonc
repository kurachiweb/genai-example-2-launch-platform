{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genai-example-2-client",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-04",
  "cache": { "enabled": false },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
  "services": [
    {
      "binding": "API",
      "service": "genai-example-2-api",
      "entrypoint": "ClientGateway",
    },
  ],
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 100, "period": 10 },
    },
  ],
  "vars": {
    "APP_ENVIRONMENT": "local",
    "LOG_LEVEL": "debug",
    "SENTRY_ENVIRONMENT": "local",
    "SENTRY_TRACES_SAMPLE_RATE": "0",
    // Cloudflare Turnstileが公開している、常に成功を返すテスト用のサイトキー
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "IMAGES_ORIGIN": "http://localhost:48043",
    "WEB_ANALYTICS_TOKEN": "",
  },
  "env": {
    "staging": {
      "services": [
        {
          "binding": "API",
          "service": "genai-example-2-api-staging",
          "entrypoint": "ClientGateway",
        },
      ],
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 100, "period": 10 },
        },
      ],
      "vars": {
        "APP_ENVIRONMENT": "staging",
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "staging",
        "SENTRY_TRACES_SAMPLE_RATE": "1",
        // 仮の値。infra-deliveryが作成したTurnstileのウィジェットとWeb Analyticsのサイトの値に置き換える
        "TURNSTILE_SITE_KEY": "0x0000000000000000000000",
        "IMAGES_ORIGIN": "https://genai-example-2-images-staging.lab.kurachiweb.com",
        "WEB_ANALYTICS_TOKEN": "00000000000000000000000000000000",
      },
      "secrets": { "required": ["SENTRY_DSN"] },
    },
    "prod": {
      "services": [
        {
          "binding": "API",
          "service": "genai-example-2-api-prod",
          "entrypoint": "ClientGateway",
        },
      ],
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "3003",
          "simple": { "limit": 100, "period": 10 },
        },
      ],
      "vars": {
        "APP_ENVIRONMENT": "prod",
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "prod",
        "SENTRY_TRACES_SAMPLE_RATE": "0.1",
        // 仮の値。infra-deliveryが作成したTurnstileのウィジェットとWeb Analyticsのサイトの値に置き換える
        "TURNSTILE_SITE_KEY": "0x0000000000000000000000",
        "IMAGES_ORIGIN": "https://genai-example-2-images.lab.kurachiweb.com",
        "WEB_ANALYTICS_TOKEN": "00000000000000000000000000000000",
      },
      "secrets": { "required": ["SENTRY_DSN"] },
    },
  },
}
