{
  "name": "event",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bun --bun eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "bun test --config=../../bunfig.toml --pass-with-no-tests --path-ignore-patterns='db/**' --path-ignore-patterns='lib/**' --path-ignore-patterns='**/*.browser.test.{ts,tsx}' --path-ignore-patterns='**/*.worker.test.{ts,tsx}' --path-ignore-patterns='**/*.e2e.test.ts' unit.test",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "dev": "wrangler dev --port 48043 --ip 0.0.0.0 --persist-to /workspace/.wrangler/state --inspector-port 9230",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check"
  },
  "dependencies": {
    "@logtape/logtape": "2.3.11",
    "@logtape/redaction": "2.3.11",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sentry/cloudflare": "11.4.0",
    "@sentry/hono": "11.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.13",
    "inversify": "8.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
