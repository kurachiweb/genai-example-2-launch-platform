{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genai-example-2-event",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "cache": { "enabled": false },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genai-example-2-dev",
      "database_id": "00000000-0000-4000-8000-000000000001",
    },
  ],
  "r2_buckets": [
    { "binding": "IMAGES_BUCKET", "bucket_name": "genai-example-2-images-dev" },
    { "binding": "FILES_BUCKET", "bucket_name": "genai-example-2-files-dev" },
    {
      "binding": "QUARANTINE_BUCKET",
      "bucket_name": "genai-example-2-quarantine-dev",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS_QUEUE", "queue": "genai-example-2-jobs-dev" },
      { "binding": "JOBS_DLQ", "queue": "genai-example-2-jobs-dlq-dev" },
    ],
    "consumers": [
      {
        "queue": "genai-example-2-jobs-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "genai-example-2-jobs-dlq-dev",
        "retry_delay": 30,
      },
      {
        "queue": "genai-example-2-jobs-dlq-dev",
        "max_batch_size": 10,
        "max_retries": 3,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 10 },
    },
  ],
  "images": { "binding": "IMAGES" },
  "vars": {
    "LOG_LEVEL": "debug",
    "SENTRY_ENVIRONMENT": "local",
    "SENTRY_TRACES_SAMPLE_RATE": "0",
    "JOBS_QUEUE_NAME": "genai-example-2-jobs-dev",
    "JOBS_DLQ_NAME": "genai-example-2-jobs-dlq-dev",
  },
  "secrets": { "required": ["HASH_PEPPER"] },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "genai-example-2-staging",
          // 仮の値。infra-deliveryがOpenTofuで作成したD1の値に、apiと同時に置き換える
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "genai-example-2-images-staging",
        },
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "genai-example-2-files-staging",
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "genai-example-2-quarantine-staging",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "JOBS_QUEUE", "queue": "genai-example-2-jobs-staging" },
          {
            "binding": "JOBS_DLQ",
            "queue": "genai-example-2-jobs-dlq-staging",
          },
        ],
        "consumers": [
          {
            "queue": "genai-example-2-jobs-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "dead_letter_queue": "genai-example-2-jobs-dlq-staging",
            "retry_delay": 30,
          },
          {
            "queue": "genai-example-2-jobs-dlq-staging",
            "max_batch_size": 10,
            "max_retries": 3,
          },
        ],
      },
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 100, "period": 10 },
        },
      ],
      "images": { "binding": "IMAGES" },
      "vars": {
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "staging",
        "SENTRY_TRACES_SAMPLE_RATE": "1",
        "JOBS_QUEUE_NAME": "genai-example-2-jobs-staging",
        "JOBS_DLQ_NAME": "genai-example-2-jobs-dlq-staging",
      },
      "secrets": { "required": ["HASH_PEPPER", "SENTRY_DSN"] },
    },
    "prod": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "genai-example-2-prod",
          // 仮の値。infra-deliveryがOpenTofuで作成したD1の値に、apiと同時に置き換える
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "genai-example-2-images-prod",
        },
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "genai-example-2-files-prod",
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "genai-example-2-quarantine-prod",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "JOBS_QUEUE", "queue": "genai-example-2-jobs-prod" },
          { "binding": "JOBS_DLQ", "queue": "genai-example-2-jobs-dlq-prod" },
        ],
        "consumers": [
          {
            "queue": "genai-example-2-jobs-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "dead_letter_queue": "genai-example-2-jobs-dlq-prod",
            "retry_delay": 30,
          },
          {
            "queue": "genai-example-2-jobs-dlq-prod",
            "max_batch_size": 10,
            "max_retries": 3,
          },
        ],
      },
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 100, "period": 10 },
        },
      ],
      "images": { "binding": "IMAGES" },
      "vars": {
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "prod",
        "SENTRY_TRACES_SAMPLE_RATE": "0.1",
        "JOBS_QUEUE_NAME": "genai-example-2-jobs-prod",
        "JOBS_DLQ_NAME": "genai-example-2-jobs-dlq-prod",
      },
      "secrets": { "required": ["HASH_PEPPER", "SENTRY_DSN"] },
    },
  },
}
