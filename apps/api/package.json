{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bun --bun eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "bun test --config=bunfig.unit.toml --pass-with-no-tests --path-ignore-patterns='common-lib/**' --path-ignore-patterns='**/*.browser.test.{ts,tsx}' --path-ignore-patterns='**/*.worker.test.{ts,tsx}' --path-ignore-patterns='**/*.e2e.test.ts' unit.test",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "dev": "wrangler dev --port 48042 --ip 0.0.0.0 --persist-to /workspace/.wrangler/state --test-scheduled",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "graphql:generate": "bun ./scripts/graphql/generate.ts",
    "graphql:allowlist": "bun ./scripts/graphql/build-allowlist.ts",
    "graphql:check": "bun ./scripts/graphql/check.ts",
    "db:migrate:local": "wrangler d1 migrations apply genai-example-2-dev --local --persist-to /workspace/.wrangler/state",
    "db:migrations:check": "bun ./scripts/check-migrations.ts",
    "admin:invite-super-admin": "bun ./scripts/admin/issue-super-admin-invitation.ts",
    "test:smoke": "bun ./scripts/smoke-wrangler-bundle.ts"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "3.2.0",
    "@graphql-yoga/plugin-disable-introspection": "2.25.6",
    "@graphql-yoga/plugin-persisted-operations": "3.24.6",
    "@hono/zod-openapi": "1.6.3",
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/hono": "11.10.0",
    "bowser": "2.14.1",
    "dataloader": "2.2.3",
    "drizzle-orm": "1.0.0-rc.5",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.6",
    "hast-util-to-text": "4.0.2",
    "hono": "4.13.14",
    "image-size": "2.0.4",
    "inversify": "8.2.3",
    "otpauth": "9.6.0",
    "reflect-metadata": "0.2.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-cjk-friendly": "2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "stripe": "23.1.0",
    "ulid": "3.0.2",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@types/bun": "1.4.4",
    "@vitest/coverage-istanbul": "4.1.12",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.124.0"
  }
}
