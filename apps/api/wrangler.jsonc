{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genai-example-2-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "cache": { "enabled": false },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
  },
  "triggers": { "crons": [] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genai-example-2-dev",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "db/migrations",
      "migrations_pattern": "db/migrations/*/migration.sql",
    },
  ],
  "r2_buckets": [
    { "binding": "IMAGES_BUCKET", "bucket_name": "genai-example-2-images-dev" },
    { "binding": "FILES_BUCKET", "bucket_name": "genai-example-2-files-dev" },
    {
      "binding": "QUARANTINE_BUCKET",
      "bucket_name": "genai-example-2-quarantine-dev",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS_QUEUE", "queue": "genai-example-2-jobs-dev" },
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMIT_COUNTER", "class_name": "RateLimitCounter" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimitCounter"] }],
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 },
    },
  ],
  "vars": {
    "LOG_LEVEL": "debug",
    "SENTRY_ENVIRONMENT": "local",
    "SENTRY_TRACES_SAMPLE_RATE": "0",
    "TURNSTILE_EXPECTED_HOSTNAMES": "",
    "APP_ENVIRONMENT": "local",
  },
  "secrets": { "required": ["HASH_PEPPER", "TURNSTILE_SECRET_KEY"] },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "genai-example-2-staging",
          // 仮の値。infra-deliveryがOpenTofuで作成したD1の値に、eventと同時に置き換える
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
          "migrations_pattern": "db/migrations/*/migration.sql",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "genai-example-2-images-staging",
        },
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "genai-example-2-files-staging",
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "genai-example-2-quarantine-staging",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "JOBS_QUEUE", "queue": "genai-example-2-jobs-staging" },
        ],
      },
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMIT_COUNTER", "class_name": "RateLimitCounter" },
        ],
      },
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 100, "period": 10 },
        },
      ],
      "vars": {
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "staging",
        "SENTRY_TRACES_SAMPLE_RATE": "1",
        "TURNSTILE_EXPECTED_HOSTNAMES": "genai-example-2-client-staging.lab.kurachiweb.com,genai-example-2-admin-staging.lab.kurachiweb.com",
        "APP_ENVIRONMENT": "staging",
      },
      "secrets": {
        "required": ["HASH_PEPPER", "TURNSTILE_SECRET_KEY", "SENTRY_DSN"],
      },
    },
    "prod": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "genai-example-2-prod",
          // 仮の値。infra-deliveryがOpenTofuで作成したD1の値に、eventと同時に置き換える
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "db/migrations",
          "migrations_pattern": "db/migrations/*/migration.sql",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES_BUCKET",
          "bucket_name": "genai-example-2-images-prod",
        },
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "genai-example-2-files-prod",
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "genai-example-2-quarantine-prod",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "JOBS_QUEUE", "queue": "genai-example-2-jobs-prod" },
        ],
      },
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMIT_COUNTER", "class_name": "RateLimitCounter" },
        ],
      },
      "ratelimits": [
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 100, "period": 10 },
        },
      ],
      "vars": {
        "LOG_LEVEL": "info",
        "SENTRY_ENVIRONMENT": "prod",
        "SENTRY_TRACES_SAMPLE_RATE": "0.1",
        "TURNSTILE_EXPECTED_HOSTNAMES": "genai-example-2-client.lab.kurachiweb.com,genai-example-2-admin.lab.kurachiweb.com",
        "APP_ENVIRONMENT": "prod",
      },
      "secrets": {
        "required": ["HASH_PEPPER", "TURNSTILE_SECRET_KEY", "SENTRY_DSN"],
      },
    },
  },
}
