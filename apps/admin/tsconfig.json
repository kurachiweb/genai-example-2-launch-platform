{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "types": ["bun", "vite/client"]
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ],
  "exclude": [
    "lib/*.ts",
    "lib/**/*.stories.tsx",
    "lib/**/*.test.ts",
    "lib/**/*.test.tsx",
    "worker-configuration.d.ts",
    "test/config/worker-env-contract.ts"
  ]
}
