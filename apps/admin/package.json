{
  "name": "admin",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bun --bun eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "bun test --config=bunfig.unit.toml --pass-with-no-tests --path-ignore-patterns='lib/**' --path-ignore-patterns='**/*.browser.test.{ts,tsx}' --path-ignore-patterns='**/*.worker.test.{ts,tsx}' --path-ignore-patterns='**/*.e2e.test.ts' unit.test",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "graphql:generate": "graphql-codegen --config codegen.config.ts",
    "graphql:check": "bun ./lib/config/codegen-check.ts",
    "cf-typegen": "wrangler types --include-runtime=false",
    "cf-typegen:check": "wrangler types --include-runtime=false --check && tsc -p tsconfig.worker-env.json",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@hookform/resolvers": "6.0.2",
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2",
    "@marsidev/react-turnstile": "1.6.3",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/tanstackstart-react": "11.10.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jotai": "3.0.1",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "graphql": "16.14.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
