# Gitメタデータはイメージビルドに不要
.git
.gitignore

# 環境変数(シークレットを含む)
.env
.env.*
!.env.example

# Wranglerのローカルシークレットファイル
.dev.vars
.dev.vars.*

# Terraformの状態ファイル・変数ファイル(シークレットを含む)
.terraform
**/.terraform
*.tfstate
*.tfstate.backup
*.tfvars
*.auto.tfvars

# コンテナ内でbun installするため、ホスト側の依存パッケージは除外する
node_modules
**/node_modules

# Git管理外のローカル開発専用データ
apps/email

# コンテナ内バインドマウント用のエイリアス先
apps/*/lib
apps/*/db

# Wranglerのローカルモードが生成するキャッシュ・状態ファイル
.wrangler
**/.wrangler

# テスト成果物
coverage
**/coverage
test-results
**/test-results
playwright-report
**/playwright-report

# AIエージェント設定
.claude
docs
.kiro

# OS生成ファイル
# macOS
.DS_Store
# Windows
Thumbs.db
desktop.ini
# Linux (KDE Plasma)
.directory

# フロントエンドのビルド成果物
.next
**/.next
dist
**/dist
build
**/build
storybook-static
**/storybook-static
